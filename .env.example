# Database Configuration (IPv4 Supabase Pooler Port 5432)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Authentication Secrets
JWT_SECRET="replace-with-a-very-strong-random-secret-key-32-chars-min"
JWT_REFRESH_SECRET="replace-with-another-very-strong-random-secret-key"

# AI Integration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# WhatsApp Cloud API Configuration
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
WEBHOOK_VERIFY_TOKEN="Saivatech"

# Background Jobs / Redis
REDIS_URL="redis://localhost:6379"

# System Config
PORT=3000
NODE_ENV="development"
